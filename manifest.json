{
  "manifest_version": 3,
  "name": "YouTube Video QA",
  "version": "3.0.0",
  "description": "Ask questions about the current YouTube video's transcript.",
  "permissions": [
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube Video QA"
  }
}